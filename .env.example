# TrackMyRun Environment Configuration
# Copy this file to .env and populate with your actual values

# ============================================================
# APPLICATION
# ============================================================

# Port for the main application server
PORT=5000

# Application environment (DEV, STAGING, PRODUCTION)
TMRENV=DEV

# ============================================================
# DATABASE (PostgreSQL)
# ============================================================

# Database host
TMRDBHOST=localhost

# Database port
TMRDBPORT=5432

# Database user
TMRDBUSER=trackmyrun_user

# Database password
TMRDBPASSWORD=your_secure_password_here

# Database name
TMRDBNAME=trackmyrun

# ============================================================
# AWS AUTHENTICATION (Cognito)
# ============================================================

# AWS Cognito Application Client ID
COGNITO_APP_CLIENT_ID=your_cognito_app_client_id

# AWS Cognito User Pool ID
COGNITO_USER_POOL_ID=your_cognito_user_pool_id

# AWS Region (e.g., us-east-1, eu-west-1)
AWS_REGION=us-east-1

# ============================================================
# STRAVA INTEGRATION
# ============================================================

# Strava OAuth Client ID
STRAVA_CLIENT_ID=your_strava_client_id

# Strava OAuth Client Secret
STRAVA_CLIENT_SECRET=your_strava_client_secret

# Strava Access Token (obtained through OAuth flow)
STRAVA_ACCESS_TOKEN=your_strava_access_token

# ============================================================
# AWS CDK (Infrastructure as Code)
# ============================================================

# AWS Account ID for CDK deployment
CDK_DEFAULT_ACCOUNT=123456789012

# AWS Region for CDK deployment
CDK_DEFAULT_REGION=us-east-1

# ============================================================
# OPTIONAL: LOGGING & MONITORING
# ============================================================

# Log level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Enable Prometheus metrics endpoint
PROMETHEUS_ENABLED=true
